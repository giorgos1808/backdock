# Azure AI Vision (Computer Vision)
AZURE_VISION_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your-key>

# Azure Storage account for scanned images, supplier orders, and product labels
AZURE_STORAGE_CONNECTION_STRING=<your-storage-account-connection-string>
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=scanned-images
AZURE_STORAGE_CONTAINER_ORDERS=supplier-orders
AZURE_STORAGE_CONTAINER_LABELS=product-labels

# Azure AI Document Intelligence (Form Recognizer)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-key>

# Postgres database storing scan metadata/results
# For local dev: docker compose up -d postgres
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/image_scanner

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=backdock

# Azure ML 
AZURE_ML_SUBSCRIPTION_ID=
AZURE_ML_RESOURCE_GROUP=
AZURE_ML_WORKSPACE_NAME=

# Development only
LOCAL_FORECAST_MODEL_PATH=
